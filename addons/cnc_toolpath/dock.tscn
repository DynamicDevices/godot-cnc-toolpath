[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/cnc_toolpath/dock.gd" id="1"]

[node name="CNCToolpathDock" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -8.0
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="Title" type="Label" parent="."]
layout_mode = 2
text = "CNC Raster Toolpath (mm)"

[node name="Hint" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
text = "Demo: open scenes/main.tscn and Play, or press Ensure Nodes then Bake in the running scene via the on-screen panel. For your own project: copy this addons/cnc_toolpath folder, enable the plugin, add MeshInstance3D + Path3D + AnimationPlayer + Tool."

[node name="ToolRadiusLabel" type="Label" parent="."]
layout_mode = 2
text = "Tool radius (mm)"

[node name="ToolRadius" type="SpinBox" parent="."]
layout_mode = 2
min_value = 0.1
max_value = 50.0
step = 0.1
value = 1.5

[node name="StepoverLabel" type="Label" parent="."]
layout_mode = 2
text = "Stepover (mm)"

[node name="Stepover" type="SpinBox" parent="."]
layout_mode = 2
min_value = 0.1
max_value = 50.0
step = 0.1
value = 2.0

[node name="SampleLabel" type="Label" parent="."]
layout_mode = 2
text = "Sample step (mm)"

[node name="SampleStep" type="SpinBox" parent="."]
layout_mode = 2
min_value = 0.1
max_value = 50.0
step = 0.1
value = 1.0

[node name="EnsureNodes" type="Button" parent="."]
layout_mode = 2
text = "Ensure CNC nodes in edited scene"

[node name="OpenDemo" type="Button" parent="."]
layout_mode = 2
text = "Open demo main.tscn"

[node name="Status" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
text = "Ready"
